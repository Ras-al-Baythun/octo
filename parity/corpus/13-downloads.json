{
  "group": "downloads",
  "description": "Backlog D (download log, drawer, Find songs picks) and B (the relayed download file name) over HTTP. Fetched songs starts with the five entries the config seed plants (fixtures/config/downloads-history.json). Find songs runs against the Lidarr stub; Glass Harbor and Paper Moons answer slowly once, which makes the two-looks-per-person refusal deterministic. Nothing is filed here. Requests that start a look are followed by an until on the look, so nothing runs into the next file.",
  "defaults": {"backlog": "D"},
  "requests": [
    {"name": "setup-ext-song3", "path": "/rest/search3", "auth": "p", "f": "json", "query": [["query", "zephyr"]], "capture": {"ext_song3": {"from": "json:subsonic-response.searchResult3.song[2].id", "normalize": false}}},
