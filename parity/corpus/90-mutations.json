{
  "group": "mutations",
  "description": "State-changing requests, run last. Every run starts from fresh containers and volumes, so these replay deterministically: stars, ratings, scrobbles and now-playing in Navidrome, a playlist round trip, an Octo settings patch, the side-effect admin POSTs, and a heart refused for a wrong password (the real hearts and their downloads are in 95-acquisition). Ids Navidrome mints here are captured and normalised.",
  "defaults": {"auth": "p", "session": "admin"},
  "requests": [
    {"name": "star-local-song-json", "path": "/rest/star", "f": "json", "query": [["id", "{{song_flac3}}"]]},
    {"name": "star-local-album-xml", "path": "/rest/star.view", "query": [["albumId", "{{album_mp3}}"]]},
    {"name": "star-local-artist-json", "path": "/rest/star", "f": "json", "query": [["artistId", "{{artist_m4a}}"]]},
    {"name": "starred2-after-json", "path": "/rest/getStarred2", "f": "json"},
    {"name": "starred-after-xml", "path": "/rest/getStarred.view"},
    {"name": "unstar-local-song-relay", "path": "/rest/unstar", "f": "json", "query": [["id", "{{song_flac3}}"]]},
    {"name": "set-rating-local-json", "path": "/rest/setRating", "f": "json", "query": [["id", "{{song_flac4}}"], ["rating", "4"]]},
    {"name": "set-rating-local-token-xml", "path": "/rest/setRating.view", "auth": "t", "query": [["id", "{{song_flac4}}"], ["rating", "2"]]},
    {"name": "set-rating-external-json", "path": "/rest/setRating", "f": "json", "query": [["id", "{{ext_song}}"], ["rating", "5"]]},
    {"name": "song-after-rating-json", "path": "/rest/getSong", "f": "json", "query": [["id", "{{song_flac4}}"]]},
    {"name": "scrobble-now-playing-json", "path": "/rest/scrobble", "f": "json", "query": [["id", "{{song_mp3_3}}"], ["submission", "false"]]},
    {"name": "now-playing-after-json", "path": "/rest/getNowPlaying", "f": "json", "ignoreKeys": ["positionMs", "minutesAgo"]},
    {"name": "scrobble-submission-xml", "path": "/rest/scrobble.view", "query": [["id", "{{song_mp3_3}}"], ["submission", "true"], ["time", "1577934245000"]]},
    {"name": "scrobble-mixed-ids-json", "path": "/rest/scrobble", "f": "json",
     "query": [["id", "{{song_m4a_1}}"], ["id", "{{ext_song}}"], ["submission", "true"], ["submission", "true"], ["time", "1577934246000"], ["time", "1577934247000"]]},
    {"name": "scrobble-external-only-json", "path": "/rest/scrobble", "f": "json", "query": [["id", "{{ext_song2}}"], ["submission", "true"]]},
    {"name": "scrobble-badpass-json", "path": "/rest/scrobble", "auth": "bad", "f": "json", "query": [["id", "{{song_m4a_1}}"]]},
    {"name": "report-playback-local-json", "path": "/rest/reportPlayback", "f": "json", "query": [["mediaId", "{{song_m4a_2}}"], ["state", "playing"], ["positionMs", "0"]]},
    {"name": "report-playback-external-xml", "path": "/rest/reportPlayback.view", "query": [["mediaId", "{{ext_song}}"], ["state", "playing"]]},
    {"name": "song-after-scrobble-json", "path": "/rest/getSong", "f": "json", "query": [["id", "{{song_mp3_3}}"]]},

    {"name": "create-playlist-json", "path": "/rest/createPlaylist", "f": "json", "query": [["name", "Parity Mix ✓"], ["songId", "{{song_flac1}}"], ["songId", "{{song_m4a_2}}"]],
     "capture": {"playlist_id": "json:subsonic-response.playlist.id"}},
    {"name": "get-playlist-xml", "path": "/rest/getPlaylist.view", "query": [["id", "{{playlist_id}}"]]},
    {"name": "update-playlist-json", "path": "/rest/updatePlaylist", "f": "json", "query": [["playlistId", "{{playlist_id}}"], ["songIdToAdd", "{{song_mp3_1}}"], ["comment", "from parity"]]},
    {"name": "playlists-after-json", "path": "/rest/getPlaylists", "f": "json"},
    {"name": "native-playlist-list-after", "path": "/api/playlist", "auth": "none", "query": [["_start", "0"], ["_end", "10"]],
     "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}, "ignoreKeys": ["thumbHash", "imageWidth", "imageHeight", "imageHash", "dominantColor", "createdAt", "updatedAt", "evaluatedAt"]},
    {"name": "delete-playlist-xml", "path": "/rest/deletePlaylist.view", "query": [["id", "{{playlist_id}}"]]},

    {"name": "settings-patch", "method": "POST", "path": "/api/admin/settings", "auth": "none", "headers": {"X-Octo-Admin": "1"},
     "body": {"json": {"Server": {"PublicUrl": "http://parity.example"}, "Subsonic": {"AdminPassword": "(saved, not shown)"}}}},
    {"name": "settings-after-patch", "path": "/api/admin/settings", "auth": "none", "delayBeforeMs": 1500},
    {"name": "raw-config-after-patch", "path": "/api/admin/raw-config", "auth": "none"},
    {"name": "clear-metadata-cache", "method": "POST", "path": "/api/admin/clear-metadata-cache", "auth": "none", "headers": {"X-Octo-Admin": "1"}},
    {"name": "test-notification-no-sinks", "method": "POST", "path": "/api/admin/test-notification", "auth": "none", "headers": {"X-Octo-Admin": "1"}},
    {"name": "update-check", "method": "POST", "path": "/api/admin/update/check", "auth": "none", "headers": {"X-Octo-Admin": "1"}},
    {"name": "lastfm-scrobble-cancel", "method": "POST", "path": "/api/admin/lastfm/scrobble/cancel", "auth": "none", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"user": "admin"}}},
    {"name": "lastfm-scrobble-finish", "method": "POST", "path": "/api/admin/lastfm/scrobble/finish", "auth": "none", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"user": "admin"}}},
    {"name": "lastfm-scrobble-disconnect", "method": "POST", "path": "/api/admin/lastfm/scrobble/disconnect", "auth": "none", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"user": "admin"}}},
    {"name": "lastfm-scrobble-connect-blank-user", "method": "POST", "path": "/api/admin/lastfm/scrobble/connect", "auth": "none", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"user": ""}}},
    {"name": "lastfm-radio-history-reset", "method": "DELETE", "path": "/api/admin/lastfm/radio/history", "auth": "none", "headers": {"X-Octo-Admin": "1"}, "query": [["user", "admin"]]},
    {"name": "review-sweep-pause", "method": "POST", "path": "/api/admin/review-sweep/pause", "auth": "none", "headers": {"X-Octo-Admin": "1"}},
    {"name": "review-sweep-reset", "method": "POST", "path": "/api/admin/review-sweep/reset", "auth": "none", "headers": {"X-Octo-Admin": "1"}},
    {"name": "genre-backfill-cancel", "method": "POST", "path": "/api/admin/genre/backfill/cancel", "auth": "none", "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "genre-backfill-resume", "method": "POST", "path": "/api/admin/genre/backfill/resume", "auth": "none", "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "genre-backfill-undo", "method": "POST", "path": "/api/admin/genre/backfill/undo", "auth": "none", "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "covers-upgrade-cancel", "method": "POST", "path": "/api/admin/covers/upgrade/cancel", "auth": "none", "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "covers-upgrade-resume", "method": "POST", "path": "/api/admin/covers/upgrade/resume", "auth": "none", "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "covers-upgrade-undo", "method": "POST", "path": "/api/admin/covers/upgrade/undo", "auth": "none", "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-library-cancel", "method": "POST", "path": "/api/admin/lyrics/library/cancel", "auth": "none", "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-library-resume", "method": "POST", "path": "/api/admin/lyrics/library/resume", "auth": "none", "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-review-dismiss", "method": "POST", "path": "/api/admin/lyrics/review/dismiss", "auth": "none",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"path": "/music/Aurora Vale/Northern Lights (2020)/03 - Midnight Sun.flac"}}},
    {"name": "lyrics-choice-auto", "method": "POST", "path": "/api/admin/lyrics/choice", "auth": "none",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"id": "{{song_flac2}}", "candidate": "auto"}}},
    {"name": "lyrics-choice-none", "method": "POST", "path": "/api/admin/lyrics/choice", "auth": "none",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"id": "{{song_mp3_2}}", "candidate": "none"}}},
    {"name": "lyrics-choices-after", "path": "/api/admin/lyrics/choices", "auth": "none", "headers": {"X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "lyrics-by-id-hidden-json", "path": "/rest/getLyricsBySongId", "f": "json", "query": [["id", "{{song_mp3_2}}"]]},
    {"name": "upgrades-cancel", "method": "POST", "path": "/api/admin/upgrades/cancel", "auth": "none",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}, "body": {"json": {"ids": ["nothing"]}}},
    {"name": "upgrades-clear", "method": "POST", "path": "/api/admin/upgrades/clear", "auth": "none",
     "headers": {"X-Octo-Admin": "1", "X-Octo-Browse-Token": "{{browse_token}}"}},
    {"name": "browse-signout", "method": "POST", "path": "/api/admin/browse/signout", "auth": "none",
     "headers": {"X-Octo-Admin": "1", "Cookie": "octo_browse={{browse_token}}"}},
    {"name": "browse-session-after-signout", "path": "/api/admin/browse/session", "auth": "none", "headers": {"Cookie": "octo_browse={{browse_token}}"}},

    {"name": "star-external-badpass", "path": "/rest/star", "auth": "bad", "f": "json", "query": [["id", "{{ext_song}}"]]}
  ]
}
