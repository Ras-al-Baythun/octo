{
  "group": "dashboard",
  "description": "Backlog N: the activity view (settled first, then a covers scan made on purpose), the Afterglow palette over a seeded fetched-songs log, and the read and refusal side of the Library actions history and Recently removed.",
  "defaults": {"auth": "none", "session": "admin", "backlog": "N"},
  "requests": [
    {"name": "activity-settle", "path": "/api/admin/activity", "ignoreKeys": ["items"], "until": {"regex": "\"items\":\\[(\\{[^{}]*\"kind\":\"covers\"[^{}]*\\})?\\]"}, "pollMs": 2000, "timeoutMs": 150000},
    {"name": "activity-alt-admin-sign-in-off", "path": "/api/admin/activity", "server": "alt-admin", "session": null},
    {"name": "activity-alt-main-port-404", "path": "/api/admin/activity", "server": "alt", "session": null},
    {"name": "ambient-seeded", "path": "/api/admin/ambient"},
    {"name": "ambient-seeded-again-cached", "path": "/api/admin/ambient"},
    {"name": "ambient-recovery", "path": "/api/admin/ambient", "session": "recovery"},
    {"name": "ambient-alt-admin-unseeded", "path": "/api/admin/ambient", "server": "alt-admin", "session": null},
    {"name": "library-actions-history-recovery", "path": "/api/admin/library-actions", "session": "recovery", "backlog": "F"},
    {"name": "library-actions-allow-download-no-key", "method": "POST", "path": "/api/admin/library-actions/allow-download", "headers": {"X-Octo-Admin": "1"}, "backlog": "F", "body": {"json": {}}},
    {"name": "library-actions-allow-download-unknown-key", "method": "POST", "path": "/api/admin/library-actions/allow-download", "headers": {"X-Octo-Admin": "1"}, "backlog": "F", "body": {"json": {"key": "parity-no-such-key"}}},
    {"name": "trash-recovery-refused", "path": "/api/admin/trash", "session": "recovery", "backlog": "R"},
    {"name": "trash-restore-library-actions-off", "method": "POST", "path": "/api/admin/trash/restore", "headers": {"X-Octo-Admin": "1"}, "backlog": "R", "body": {"json": {"id": "parity-no-such-song"}}},
    {"name": "trash-restore-recovery-refused", "method": "POST", "path": "/api/admin/trash/restore", "session": "recovery", "headers": {"X-Octo-Admin": "1"}, "backlog": "R", "body": {"json": {"id": "parity-no-such-song"}}},
    {"name": "covers-scan-for-activity", "method": "POST", "path": "/api/admin/covers/upgrade", "headers": {"X-Octo-Admin": "1"}, "backlog": "N,P", "body": {"json": {"scope": "WholeLibrary", "mode": "Scan"}}},
    {"name": "covers-scan-for-activity-done", "path": "/api/admin/covers/upgrade", "backlog": "N,P", "unordered": true, "until": {"from": "json:busy", "in": ["False"]}, "pollMs": 300, "timeoutMs": 30000, "capture": {"covers_run_18": "json:runId"}},
    {"name": "activity-covers-done", "path": "/api/admin/activity"},
    {"name": "activity-recovery-signed", "path": "/api/admin/activity", "session": "recovery"},
    {"name": "activity-alt-admin-after", "path": "/api/admin/activity", "server": "alt-admin", "session": null}
  ]
}
