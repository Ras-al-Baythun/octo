    {"name": "typed-onto-placeholder-lastfm-secret", "backlog": "I", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"LastFm": {"ApiSecret": "(saved, not shown) x"}}}},
