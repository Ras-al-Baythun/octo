{
  "group": "settings-media",
  "description": "Draft d6 (split later). K: the bare address 302. A: Last.fm search cleanup through search3. O: outside albums the library holds (search3/search2/getArtist/getAlbum). S: a transcode's estimated length is never promised (rest/stream, HEAD, download). I: every secret in the admin API is the placeholder, the placeholder keeps the stored value, a secret never follows a moved address. J: the signed-out status cache, recovery code, browse/session fields, sign out, the role check on a demoted or deleted admin. Every settings write is undone before the file ends. Needs the env additions and stubs in NOTES.md.",
  "defaults": {"auth": "none", "session": "admin"},
  "requests": [
    {"name": "root-get", "backlog": "K", "session": null, "path": "/"},
    {"name": "root-head", "backlog": "K", "session": null, "method": "HEAD", "path": "/"},
    {"name": "root-get-subsonic-query", "backlog": "K", "session": null, "path": "/", "rawQuery": "u={{admin_user}}&p={{admin_pass}}&v=1.16.1&c=Amperfy&f=json"},
    {"name": "root-get-accept-html", "backlog": "K", "session": null, "path": "/", "headers": {"Accept": "text/html,application/xhtml+xml"}},
    {"name": "root-post-relayed", "backlog": "K", "session": null, "method": "POST", "path": "/", "body": {"raw": "", "contentType": "application/x-www-form-urlencoded"}},
    {"name": "root-redirect-target", "backlog": "K", "session": null, "path": "/app/"},
    {"name": "search3-cleanup-stronger-json", "backlog": "A", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "stronger"], ["artistCount", "0"], ["albumCount", "0"], ["songCount", "20"]]},
    {"name": "search3-cleanup-stronger-xml", "backlog": "A", "auth": "p", "session": null, "path": "/rest/search3.view", "query": [["query", "stronger"], ["artistCount", "0"], ["albumCount", "0"], ["songCount", "20"]]},
    {"name": "search3-cleanup-nightcall-json", "backlog": "A", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "nightcall"], ["artistCount", "0"], ["albumCount", "0"], ["songCount", "20"]]},
    {"name": "search2-cleanup-stronger-json", "backlog": "A", "auth": "p", "f": "json", "session": null, "path": "/rest/search2", "query": [["query", "stronger"], ["artistCount", "0"], ["albumCount", "0"], ["songCount", "20"]]},
    {"name": "native-song-search-cleanup-nightcall", "backlog": "A", "session": null, "path": "/api/song", "query": [["title", "nightcall"], ["_start", "0"], ["_end", "20"]], "headers": {"X-ND-Authorization": "Bearer {{nd_token}}"}},
    {"name": "search3-owned-whole-remaster-settle", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "remaster"]], "until": {"regex": "^(?![\\s\\S]*2020 Remaster)"}, "pollMs": 500, "timeoutMs": 20000},
    {"name": "search3-owned-whole-remaster-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "remaster"]]},
    {"name": "search3-owned-whole-remaster-xml", "backlog": "O", "auth": "p", "session": null, "path": "/rest/search3.view", "query": [["query", "remaster"]]},
    {"name": "search2-owned-whole-remaster-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search2", "query": [["query", "remaster"]], "until": {"regex": "\"ownedCount\":\\s*4"}, "pollMs": 500, "timeoutMs": 20000, "capture": {"o_album_whole": {"from": "json:subsonic-response.searchResult2.album[0].id", "normalize": false}}},
    {"name": "search2-owned-whole-remaster-xml", "backlog": "O", "auth": "p", "session": null, "path": "/rest/search2.view", "query": [["query", "remaster"]]},
    {"name": "search3-northern-lights-settle", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "Northern Lights"]], "until": {"regex": "^(?![\\s\\S]*2020 Remaster)"}, "pollMs": 500, "timeoutMs": 20000},
    {"name": "search3-northern-lights-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "Northern Lights"]]},
    {"name": "search3-northern-lights-xml", "backlog": "O", "auth": "p", "session": null, "path": "/rest/search3.view", "query": [["query", "Northern Lights"]]},
    {"name": "search3-partly-owned-settle", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "Ágætis Prófun"]], "until": {"regex": "\"ownedCount\":\\s*3"}, "pollMs": 500, "timeoutMs": 20000},
    {"name": "search3-partly-owned-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "Ágætis Prófun"]], "capture": {"o_album_part": {"from": "json:subsonic-response.searchResult3.album[1].id", "normalize": false}}},
    {"name": "search3-partly-owned-xml", "backlog": "O", "auth": "p", "session": null, "path": "/rest/search3.view", "query": [["query", "Ágætis Prófun"]]},
    {"name": "search3-partly-owned-albums-only-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "Ágætis Prófun"], ["songCount", "0"], ["artistCount", "0"]]},
    {"name": "search3-outside-artist-friends", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/search3", "query": [["query", "friends"], ["songCount", "0"], ["albumCount", "0"]], "capture": {"o_artist_friends": {"from": "json:subsonic-response.searchResult3.artist[0].id", "normalize": false}}},
    {"name": "getartist-outside-settle", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/getArtist", "query": [["id", "{{o_artist_friends}}"]], "until": {"regex": "(?s)(?=.*\"ownedCount\":\\s*4)(?=.*\"ownedCount\":\\s*0)"}, "pollMs": 500, "timeoutMs": 20000},
    {"name": "getartist-outside-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/getArtist", "query": [["id", "{{o_artist_friends}}"]], "capture": {"o_album_none": {"from": "regex:\"id\":\"([^\"]+)\",\"parent\":\"[^\"]*\",\"isDir\":true,\"title\":\"Borealis\"", "normalize": false}}},
    {"name": "getartist-outside-xml", "backlog": "O", "auth": "p", "session": null, "path": "/rest/getArtist.view", "query": [["id", "{{o_artist_friends}}"]]},
    {"name": "getalbum-outside-owned-whole-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/getAlbum", "query": [["id", "{{o_album_whole}}"]], "until": {"regex": "\"ownedCount\":\\s*4"}, "pollMs": 500, "timeoutMs": 20000},
    {"name": "getalbum-outside-owned-whole-xml", "backlog": "O", "auth": "p", "session": null, "path": "/rest/getAlbum.view", "query": [["id", "{{o_album_whole}}"]]},
    {"name": "getalbum-outside-owned-part-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/getAlbum", "query": [["id", "{{o_album_part}}"]], "until": {"regex": "\"ownedCount\":\\s*3"}, "pollMs": 500, "timeoutMs": 20000},
    {"name": "getalbum-outside-owned-part-xml", "backlog": "O", "auth": "p", "session": null, "path": "/rest/getAlbum.view", "query": [["id", "{{o_album_part}}"]]},
    {"name": "getalbum-outside-owned-none-json", "backlog": "O", "auth": "p", "f": "json", "session": null, "path": "/rest/getAlbum", "query": [["id", "{{o_album_none}}"]]},
    {"name": "stream-flac-mp3-live", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_flac1}}"], ["format", "mp3"], ["maxBitRate", "128"]]},
    {"name": "stream-flac-mp3-live-estimate", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_flac2}}"], ["format", "mp3"], ["maxBitRate", "128"], ["estimateContentLength", "true"]]},
    {"name": "stream-flac-mp3-cached", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "delayBeforeMs": 1500, "query": [["id", "{{song_flac1}}"], ["format", "mp3"], ["maxBitRate", "128"]], "until": {"from": "header:Accept-Ranges", "in": ["bytes"]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "stream-flac-mp3-cached-estimate", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_flac1}}"], ["format", "mp3"], ["maxBitRate", "128"], ["estimateContentLength", "true"]], "until": {"from": "header:Accept-Ranges", "in": ["bytes"]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "stream-flac-mp3-cached-range", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_flac1}}"], ["format", "mp3"], ["maxBitRate", "128"]], "headers": {"Range": "bytes=0-99"}, "until": {"status": [206]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "stream-flac-mp3-cached-416", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_flac1}}"], ["format", "mp3"], ["maxBitRate", "128"]], "headers": {"Range": "bytes=99999999-"}, "until": {"status": [416]}, "pollMs": 500, "timeoutMs": 15000},
    {"name": "stream-flac-mp3-live-range", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_flac3}}"], ["format", "mp3"], ["maxBitRate", "96"]], "headers": {"Range": "bytes=0-99"}},
    {"name": "stream-flac-mp3-64-live", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_flac4}}"], ["format", "mp3"], ["maxBitRate", "64"]]},
    {"name": "stream-mp3-maxbitrate-above-file-raw", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_mp3_1}}"], ["maxBitRate", "128"], ["estimateContentLength", "true"]]},
    {"name": "stream-mp3-raw-416", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_mp3_1}}"]], "headers": {"Range": "bytes=99999999-"}},
    {"name": "stream-mp3-format-same-raw", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_mp3_2}}"], ["format", "mp3"]]},
    {"name": "stream-mp3-raw-range-with-format", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_mp3_2}}"], ["format", "mp3"]], "headers": {"Range": "bytes=0-99"}},
    {"name": "stream-mp3-transcode-down", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_mp3_3}}"], ["format", "mp3"], ["maxBitRate", "16"]]},
    {"name": "stream-m4a-format-raw-estimate", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{song_m4a_1}}"], ["format", "raw"], ["estimateContentLength", "true"]]},
    {"name": "stream-m4a-mp3-live", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream.view", "query": [["id", "{{song_m4a_2}}"], ["format", "mp3"], ["maxBitRate", "96"]]},
    {"name": "stream-m4a-mp3-live-post-form", "backlog": "S", "keepLengthHeaders": true, "auth": "none", "f": null, "session": null, "method": "POST", "path": "/rest/stream", "body": {"form": [["u", "{{admin_user}}"], ["p", "{{admin_pass}}"], ["v", "1.16.1"], ["c", "parity"], ["id", "{{song_m4a_3}}"], ["format", "mp3"], ["maxBitRate", "64"]]}},
    {"name": "head-stream-flac-mp3-estimate", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "method": "HEAD", "path": "/rest/stream", "query": [["id", "{{song_flac2}}"], ["format", "mp3"], ["maxBitRate", "112"], ["estimateContentLength", "true"]]},
    {"name": "head-stream-flac-mp3-no-estimate", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "method": "HEAD", "path": "/rest/stream", "query": [["id", "{{song_flac3}}"], ["format", "mp3"], ["maxBitRate", "80"]]},
    {"name": "head-stream-mp3-raw", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "method": "HEAD", "path": "/rest/stream", "query": [["id", "{{song_mp3_2}}"], ["estimateContentLength", "true"]]},
    {"name": "download-flac-mp3-estimate", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/download", "query": [["id", "{{song_flac4}}"], ["format", "mp3"], ["bitrate", "128"], ["estimateContentLength", "true"]]},
    {"name": "download-mp3-format-raw", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/download", "query": [["id", "{{song_mp3_3}}"], ["format", "raw"]]},
    {"name": "stream-external-format", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{ext_song}}"], ["format", "mp3"], ["maxBitRate", "128"], ["estimateContentLength", "true"]]},
    {"name": "stream-external-format-range", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{ext_song}}"], ["format", "mp3"], ["maxBitRate", "128"]], "headers": {"Range": "bytes=0-99"}},
    {"name": "stream-external-format-416", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "path": "/rest/stream", "query": [["id", "{{ext_song}}"], ["format", "opus"]], "headers": {"Range": "bytes=99999999-"}},
    {"name": "head-stream-external-format", "backlog": "S", "keepLengthHeaders": true, "auth": "p", "f": null, "session": null, "method": "HEAD", "path": "/rest/stream", "query": [["id", "{{ext_song}}"], ["format", "mp3"], ["maxBitRate", "128"]]},
    {"name": "settings-env-secrets-masked", "backlog": "I", "path": "/api/admin/settings"},
    {"name": "raw-config-env-secrets-masked", "backlog": "I", "path": "/api/admin/raw-config"},
    {"name": "config-sources-env-secrets-masked", "backlog": "I", "path": "/api/admin/config-sources"},
    {"name": "settings-signed-out", "backlog": "I,J", "session": null, "path": "/api/admin/settings"},
    {"name": "settings-file-before", "backlog": "I", "exec": ["cat", "/app/config/settings.json"]},
    {"name": "settings-save-typed-secrets", "backlog": "I", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"Downloads": {"AcoustIdApiKey": "parity-acoustid-app-key", "AcoustIdUserApiKey": "parity-acoustid-user-key"}, "LastFm": {"ApiSecret": "parity-lastfm-secret"}, "Notifications": {"DiscordWebhookUrl": "https://discord.com/api/webhooks/1234567890/parity-webhook-token"}, "ListenBrainz": {"Token": "parity-lb-default-token"}}}},
    {"name": "settings-after-typed-secrets", "backlog": "I", "path": "/api/admin/settings", "delayBeforeMs": 1500},
    {"name": "settings-file-after-typed-secrets", "backlog": "I", "exec": ["cat", "/app/config/settings.json"]},
    {"name": "settings-echo-every-placeholder", "backlog": "I", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"Subsonic": {"AdminUsername": "admin", "AdminPassword": "(saved, not shown)"}, "Downloads": {"AcoustIdApiKey": "(saved, not shown)", "AcoustIdUserApiKey": "(saved, not shown)"}, "Lidarr": {"BaseUrl": "http://stubs:8686", "ApiKey": "(saved, not shown)"}, "LastFm": {"ApiKey": "(saved, not shown)", "ApiSecret": "(saved, not shown)", "UserSessions": {"ghost": {"SessionKey": "(saved, not shown)", "LastFmUser": "ghost-on-lastfm"}}}, "Notifications": {"NtfyUrl": "", "NtfyToken": "(saved, not shown)", "DiscordWebhookUrl": "(saved, not shown)"}, "ListenBrainz": {"Token": "(saved, not shown)", "UserTokens": {"ghost": "(saved, not shown)"}}, "_meta": {"SecretPlaceholder": "(saved, not shown)"}}}},
    {"name": "settings-file-after-echo", "backlog": "I", "exec": ["cat", "/app/config/settings.json"], "delayBeforeMs": 500},
    {"name": "settings-after-echo", "backlog": "I", "path": "/api/admin/settings", "delayBeforeMs": 1000},
    {"name": "typed-onto-placeholder-acoustid-app", "backlog": "I", "method": "POST", "path": "/api/admin/settings", "headers": {"X-Octo-Admin": "1"}, "body": {"json": {"Downloads": {"AcoustIdApiKey": "(saved, not shown)x"}}}},
